[proxmox]
# Define Proxmox VE hosts with their respective IP addresses.
# pve01 must stay last: Semaphore runs on it (LXC 112), so the update
# playbook reboots it only after everything else is done.
pve02 ansible_host=192.168.10.33
pve03 ansible_host=192.168.10.99
pbs ansible_host=192.168.10.160
pve-datacenter-manager ansible_host=192.168.10.240
pve01 ansible_host=192.168.10.88

[semaphore_host]
# The host whose LXC runs Semaphore (docker LXC 112 is pinned to pve01).
pve01

# The following group variable sets the Python interpreter for all hosts in the [proxmox] group.
# This avoids Python version warnings and makes it easy to change the interpreter in one place.
[proxmox:vars]
ansible_python_interpreter=/usr/bin/python3

[pve_cluster]
pve01
pve02
pve03

[lxc]
# Guest LXCs (CTID in the comment). No playbook connects to these over SSH:
# update-apt-packages-lxcs and update-lxc-apps reach them from the Proxmox
# nodes with pct exec, configured by CTID in vars/lxc_updates.yml.
docker-lxc ansible_host=192.168.10.41      # 112
homeassistant ansible_host=192.168.10.126  # 115
homebridge ansible_host=192.168.10.149     # 105
homelabhero ansible_host=192.168.10.10     # 114
homepage ansible_host=192.168.10.9         # 103
immich ansible_host=192.168.10.244         # 113
nginx ansible_host=192.168.10.93           # 101
pihole ansible_host=192.168.10.55          # 100
prometheus ansible_host=192.168.10.64      # 106
stirling-pdf ansible_host=192.168.10.233   # 102

